# Reverse proxy AXORA-ERP24.
#
# 1. Site public ({$PUBLIC_HOST}) : HTTPS automatique (Let's Encrypt),
#    HTTP/2 et HTTP/3, compression, journaux JSON. L'API reste servie par
#    l'interface sous /api/v1 (cookie de session first-party). La creation
#    d'espaces y est toujours refusee : le premier administrateur se cree par
#    l'acces prive, sans course possible avec un visiteur d'Internet.
# 2. Acces d'administration prive (:3110) : publie uniquement sur 127.0.0.1 du
#    VPS et expose au tailnet par `tailscale serve` (HTTPS Tailscale).
#
# Adresse du client : seul tailscale serve (vu par Caddy depuis la passerelle
# Docker, PROXY_GATEWAY) peut fournir X-Forwarded-For ; c'est l'adresse
# tailnet reelle de l'appareil. Sur le site public, aucun en-tete client
# n'est cru : l'adresse vue par Caddy fait foi (pas d'usurpation possible).
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static {$PROXY_GATEWAY:172.24.0.1/32}
		client_ip_headers X-Forwarded-For
	}
}

(proxy_web) {
	encode zstd gzip

	# Pieces jointes GED et preuves de chantier.
	request_body {
		max_size 50MB
	}

	reverse_proxy web:3100 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
	}

	log {
		output stdout
		format json
	}
}

{$PUBLIC_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Instance privee : aucune creation d'organisation depuis Internet.
	@registration path /api/v1/auth/register-organization
	respond @registration `{"message":"La création d'espaces est fermée sur cette instance. Demandez un accès à votre administrateur.","statusCode":403}` 403

	import proxy_web
}

# Acces prive (tailnet uniquement, via tailscale serve).
:3110 {
	header -Server
	import proxy_web
}
