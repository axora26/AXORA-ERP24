// ---------------------------------------------------------------------------
// INC-07 — Stock & Logistique (docs/foundation/02-domain-model.md BC-06)
//
// INVARIANTS (garantis par la BASE, pas seulement par l'application) :
// 1. Le grand livre des mouvements est append-only : un trigger PostgreSQL
//    refuse tout UPDATE et tout DELETE sur stock_movements.
// 2. Un solde n'est jamais negatif : contrainte CHECK (quantity >= 0) sur
//    stock_balances ; toute sortie est refusee au-dela du disponible.
// 3. Valorisation au cout moyen pondere par article et magasin ; chaque
//    mouvement porte sa valeur, le solde valorise est la somme exacte.
// 4. Une sortie chantier porte obligatoirement le projet consommateur.
// ---------------------------------------------------------------------------

enum StockMovementType {
  RECEIPT
  ISSUE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum WarehouseKind {
  WAREHOUSE
  SITE
}

enum StockCountStatus {
  OPEN
  CLOSED
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  unitCode       String
  category       String?
  barcode        String?
  /// Seuil d'alerte (reapprovisionnement) sur le stock total de l'entreprise.
  minStock       Decimal  @default(0) @db.Decimal(18, 3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  balances  StockBalance[]
  movements StockMovement[]

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, isActive])
  @@map("inventory_items")
}

model Warehouse {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  kind           WarehouseKind @default(WAREHOUSE)
  /// Magasin de chantier rattache a un projet (kind = SITE).
  projectId      String?
  location       String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  balances  StockBalance[]
  movements StockMovement[]
  counts    StockCount[]

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId])
  @@map("warehouses")
}

/// Solde courant article x magasin, maintenu dans la transaction de chaque mouvement.
model StockBalance {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  itemId         String
  warehouseId    String
  quantity       Decimal  @default(0) @db.Decimal(18, 3)
  value          Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt      DateTime @updatedAt

  item      InventoryItem @relation(fields: [itemId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  @@unique([itemId, warehouseId])
  @@index([organizationId, companyId, warehouseId])
  @@map("stock_balances")
}

/// Grand livre append-only (trigger de protection en base).
model StockMovement {
  id                 String            @id @default(cuid())
  organizationId     String
  companyId          String
  itemId             String
  warehouseId        String
  type               StockMovementType
  /// Variation signee de quantite (+ entree, - sortie).
  quantityDelta      Decimal           @db.Decimal(18, 3)
  /// Cout unitaire applique (cout moyen pour une sortie, prix d'achat pour une reception).
  unitCost           Decimal           @db.Decimal(18, 4)
  /// Variation signee de valeur, arrondie au centime.
  valueDelta         Decimal           @db.Decimal(18, 2)
  projectId          String?
  wbsItemId          String?
  goodsReceiptLineId String?
  transferGroupId    String?
  countId            String?
  reference          String?
  reason             String?
  idempotencyKey     String?
  createdByUserId    String
  createdAt          DateTime          @default(now())

  item      InventoryItem @relation(fields: [itemId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  @@unique([companyId, idempotencyKey, itemId, warehouseId, type])
  @@index([organizationId, companyId, itemId, createdAt])
  @@index([organizationId, companyId, warehouseId, createdAt])
  @@index([projectId])
  @@map("stock_movements")
}

/// Inventaire physique d'un magasin : les ecarts deviennent des ajustements traces.
model StockCount {
  id              String           @id @default(cuid())
  organizationId  String
  companyId       String
  code            String
  warehouseId     String
  status          StockCountStatus @default(OPEN)
  createdByUserId String
  closedByUserId  String?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  lines     StockCountLine[]

  @@unique([companyId, code])
  @@index([organizationId, companyId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id              String   @id @default(cuid())
  countId         String
  itemId          String
  /// Quantite theorique figee a l'ouverture de l'inventaire.
  systemQuantity  Decimal  @db.Decimal(18, 3)
  countedQuantity Decimal? @db.Decimal(18, 3)

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, itemId])
  @@map("stock_count_lines")
}
