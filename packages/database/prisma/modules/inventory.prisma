// ---------------------------------------------------------------------------
// INC-07 — Stock & Logistique (docs/foundation/02-domain-model.md BC-06)
//
// INVARIANTS (garantis par la BASE, pas seulement par l'application) :
// 1. Le grand livre des mouvements est append-only : un trigger PostgreSQL
//    refuse tout UPDATE et tout DELETE sur stock_movements.
// 2. Un solde n'est jamais negatif : contrainte CHECK (quantity >= 0) sur
//    stock_balances ; toute sortie est refusee au-dela du disponible.
// 3. Valorisation au cout moyen pondere par article et magasin ; chaque
//    mouvement porte sa valeur, le solde valorise est la somme exacte.
// 4. Une sortie chantier porte obligatoirement le projet consommateur.
// ---------------------------------------------------------------------------

enum StockMovementType {
  RECEIPT
  ISSUE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  /// Sortie de pieces pour un ordre de travail de maintenance (GMAO).
  MAINTENANCE_ISSUE
  /// Sortie du depot vers le fournisseur (retour d'achat).
  SUPPLIER_RETURN
}

enum WarehouseKind {
  WAREHOUSE
  SITE
}

enum StockCountStatus {
  OPEN
  CLOSED
}

enum StockReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
}

enum StockReservationEventType {
  RESERVE
  ISSUE
  RELEASE
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  unitCode       String
  category       String?
  barcode        String?
  /// Seuil d'alerte (reapprovisionnement) sur le stock total de l'entreprise.
  minStock       Decimal  @default(0) @db.Decimal(18, 3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  balances  StockBalance[]
  movements StockMovement[]
  reservations StockReservation[]

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, isActive])
  @@map("inventory_items")
}

model Warehouse {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  kind           WarehouseKind @default(WAREHOUSE)
  /// Magasin de chantier rattache a un projet (kind = SITE).
  projectId      String?
  location       String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  balances  StockBalance[]
  movements StockMovement[]
  counts    StockCount[]
  reservations StockReservation[]

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId])
  @@map("warehouses")
}

/// Solde courant article x magasin, maintenu dans la transaction de chaque mouvement.
model StockBalance {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  itemId         String
  warehouseId    String
  quantity       Decimal  @default(0) @db.Decimal(18, 3)
  value          Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt      DateTime @updatedAt

  item      InventoryItem @relation(fields: [itemId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  reservations StockReservation[]

  @@unique([itemId, warehouseId])
  @@index([organizationId, companyId, warehouseId])
  @@map("stock_balances")
}

/// Grand livre append-only (trigger de protection en base).
model StockMovement {
  id                 String            @id @default(cuid())
  organizationId     String
  companyId          String
  itemId             String
  warehouseId        String
  type               StockMovementType
  /// Variation signee de quantite (+ entree, - sortie).
  quantityDelta      Decimal           @db.Decimal(18, 3)
  /// Cout unitaire applique (cout moyen pour une sortie, prix d'achat pour une reception).
  unitCost           Decimal           @db.Decimal(18, 4)
  /// Variation signee de valeur, arrondie au centime.
  valueDelta         Decimal           @db.Decimal(18, 2)
  projectId          String?
  wbsItemId          String?
  goodsReceiptLineId String?
  /// Ligne de retour fournisseur a l'origine d'une sortie SUPPLIER_RETURN.
  supplierReturnLineId String?
  transferGroupId    String?
  countId            String?
  reference          String?
  reason             String?
  idempotencyKey     String?
  createdByUserId    String
  createdAt          DateTime          @default(now())
  reservationId      String?

  item      InventoryItem @relation(fields: [itemId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  reservation StockReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([companyId, idempotencyKey, itemId, warehouseId, type])
  @@index([organizationId, companyId, itemId, createdAt])
  @@index([organizationId, companyId, warehouseId, createdAt])
  @@index([projectId])
  @@map("stock_movements")
}

/// Allocation future de stock : ne modifie ni le physique ni sa valorisation.
/// Le reste est consomme dans la meme transaction que la sortie associee.
model StockReservation {
  id               String                  @id @default(cuid())
  organizationId   String
  companyId        String
  projectId        String
  wbsItemId        String?
  itemId           String
  warehouseId      String
  quantity         Decimal                 @db.Decimal(18, 3)
  remainingQuantity Decimal                @db.Decimal(18, 3)
  status           StockReservationStatus  @default(ACTIVE)
  neededAt         DateTime?
  reason           String
  createdByUserId  String
  releasedByUserId String?
  releasedAt       DateTime?
  version          Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  project   Project        @relation(fields: [projectId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Cascade)
  item      InventoryItem  @relation(fields: [itemId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  balance   StockBalance   @relation(fields: [itemId, warehouseId], references: [itemId, warehouseId], onDelete: Restrict)
  wbsItem   ProjectWbsItem? @relation(fields: [wbsItemId], references: [id], onDelete: Restrict)
  events    StockReservationEvent[]
  movements StockMovement[]

  @@index([organizationId, companyId, projectId, status])
  @@index([organizationId, companyId, itemId, warehouseId, status])
  @@index([wbsItemId])
  @@map("stock_reservations")
}

/// Journal append-only des changements de réservation.
model StockReservationEvent {
  id             String                    @id @default(cuid())
  organizationId String
  companyId      String
  reservationId  String
  type           StockReservationEventType
  quantity       Decimal                   @db.Decimal(18, 3)
  operationKey   String
  reason         String?
  movementId     String?
  createdByUserId String
  createdAt      DateTime                  @default(now())

  reservation StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([companyId, operationKey])
  @@index([organizationId, companyId, reservationId, createdAt])
  @@map("stock_reservation_events")
}

/// Inventaire physique d'un magasin : les ecarts deviennent des ajustements traces.
model StockCount {
  id              String           @id @default(cuid())
  organizationId  String
  companyId       String
  code            String
  warehouseId     String
  status          StockCountStatus @default(OPEN)
  createdByUserId String
  closedByUserId  String?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())

  warehouse Warehouse        @relation(fields: [warehouseId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  lines     StockCountLine[]

  @@unique([companyId, code])
  @@index([organizationId, companyId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id              String   @id @default(cuid())
  countId         String
  itemId          String
  /// Quantite theorique figee a l'ouverture de l'inventaire.
  systemQuantity  Decimal  @db.Decimal(18, 3)
  countedQuantity Decimal? @db.Decimal(18, 3)

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, itemId])
  @@map("stock_count_lines")
}
