// AXORA-ERP24 — Schema Prisma, Phase INC-01 (Core / Identity / RBAC / Audit)
// Reference : docs/foundation/02-domain-model.md, docs/foundation/03-security.md
//
// INVARIANTS NON NEGOCIABLES (ne jamais contourner en code applicatif) :
// 1. Toute table metier porte organizationId — isolation tenant obligatoire.
// 2. AuditLog est append-only : aucune route API ne doit exposer UPDATE/DELETE dessus.
// 3. Les montants financiers utilisent Decimal, jamais Float (regle appliquee des Phase C).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Socle multi-tenant (docs/foundation/02-domain-model.md)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  legalName      String?
  /// Devise de reference (valorisation du stock, consolidation) — ISO 4217.
  currency       String   @default("USD") @db.Char(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
  users        CompanyMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identite et acces (INC-01)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  organizationId      String
  email               String
  passwordHash        String
  fullName            String
  isActive            Boolean   @default(true)
  mfaEnabled          Boolean   @default(false)
  mfaSecretEnc        String?
  /// Secret TOTP en cours d'enrolement (chiffre), confirme par un premier code valide.
  mfaPendingSecretEnc String?
  /// Dernier pas TOTP accepte (anti-rejeu : un code ne sert qu'une fois).
  mfaLastCounter      Int?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyMemberships CompanyMembership[]
  sessions           Session[]
  roleAssignments    RoleAssignment[]
  auditLogs          AuditLog[]
  mfaChallenges      MfaChallenge[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginThrottle {
  keyHash         String    @id @db.Char(64)
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @default(now()) @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([blockedUntil])
  @@map("login_throttles")
}

// ---------------------------------------------------------------------------
// RBAC deny-by-default (docs/foundation/03-security.md)
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  assignments  RoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  companyId String?
  projectId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId, projectId])
  @@index([userId])
  @@map("role_assignments")
}

// ---------------------------------------------------------------------------
// Audit append-only (docs/foundation/01-architecture.md §5.1)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// INC-02 — CRM (prospects -> opportunites -> pipeline)
// Reference : docs/foundation/06-product-backlog.md #INC-02
//
// INVARIANTS DE CE DOMAINE :
// 1. Toute entite porte organizationId ET companyId (scope entreprise exige
//    par le backlog INC-02). Le companyId n'est jamais accepte tel quel depuis
//    le client : il est verifie contre les CompanyMembership de la session.
// 2. CrmActivity est append-only (historique client immuable) : pas de champ
//    updatedAt, aucune route d'update/delete exposee.
// 3. Les montants utilisent Decimal(18,2) — jamais Float sur un prix.
// ---------------------------------------------------------------------------

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum CrmOpportunityStatus {
  OPEN
  WON
  LOST
}

enum CrmActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  TASK
  STAGE_CHANGE
  CONVERSION
}

model CrmAccount {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  industry       String?
  city           String?
  country        String?
  website        String?
  phone          String?
  email          String?
  ownerUserId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts      CrmContact[]
  leads         CrmLead[]
  opportunities CrmOpportunity[]

  @@unique([companyId, name])
  @@index([organizationId, companyId])
  @@map("crm_accounts")
}

model CrmContact {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  accountId      String?
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account       CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunities CrmOpportunity[]

  @@index([organizationId, companyId])
  @@index([accountId])
  @@map("crm_contacts")
}

model CrmLead {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String
  accountId      String?
  contactName    String
  companyName    String
  email          String?
  phone          String?
  source         String?
  status         CrmLeadStatus @default(NEW)
  ownerUserId    String?
  convertedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account       CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunities CrmOpportunity[]

  @@index([organizationId, companyId])
  @@index([companyId, status])
  @@map("crm_leads")
}

model CrmPipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  position       Int
  probability    Int      @default(0)
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunities CrmOpportunity[]

  @@unique([companyId, name])
  @@index([organizationId, companyId])
  @@map("crm_pipeline_stages")
}

model CrmOpportunity {
  id                String               @id @default(cuid())
  organizationId    String
  companyId         String
  accountId         String?
  contactId         String?
  sourceLeadId      String?
  stageId           String
  name              String
  amount            Decimal              @default(0) @db.Decimal(18, 2)
  currency          String               @default("USD") @db.Char(3)
  expectedCloseDate DateTime?
  status            CrmOpportunityStatus @default(OPEN)
  ownerUserId       String?
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  account    CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    CrmContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceLead CrmLead?         @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  stage      CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@index([organizationId, companyId])
  @@index([companyId, status])
  @@index([stageId])
  @@map("crm_opportunities")
}

/// Historique client IMMUABLE (backlog INC-02 : "historique client immuable
/// des activites"). Aucun updatedAt, aucune route UPDATE/DELETE exposee.
model CrmActivity {
  id             String          @id @default(cuid())
  organizationId String
  companyId      String
  type           CrmActivityType
  subject        String
  body           String?
  relatedType    String
  relatedId      String
  actorUserId    String?
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([organizationId, companyId])
  @@index([companyId, relatedType, relatedId])
  @@map("crm_activities")
}

// ---------------------------------------------------------------------------
// INC-03 — Estimation : Study -> DQE (tranche verticale fondatrice)
// Reference : docs/foundation/06-product-backlog.md #INC-03 et ADR-0044 du
// depot ERP3602 en lecture seule.
//
// INVARIANTS :
// 1. Le scope organisation/entreprise vient exclusivement de la session.
// 2. Quantites et prix sont Decimal(24,6), jamais Float/number JavaScript.
// 3. Les exigences d'etude et la source Study -> DQE sont append-only.
// 4. Un DQE finalise ne peut plus recevoir de ligne.
// ---------------------------------------------------------------------------

enum EstimationStudyStatus {
  DRAFT
  READY_FOR_DQE
  ARCHIVED
}

enum EstimationRequirementCategory {
  FACT
  ASSUMPTION
  CONSTRAINT
  RISK
  NOTE
}

enum DqeStatus {
  DRAFT
  FINALIZED
  ARCHIVED
}

model EstimationStudy {
  id              String                @id @default(cuid())
  organizationId  String
  companyId       String
  opportunityId   String
  code            String
  title           String
  objective       String
  sourceReference String?
  status          EstimationStudyStatus @default(DRAFT)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  requirements EstimationStudyRequirement[]
  dqeSources   DqeStudySource[]

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, status, createdAt])
  @@index([opportunityId])
  @@map("estimation_studies")
}

model EstimationStudyRequirement {
  id              String                        @id @default(cuid())
  organizationId  String
  companyId       String
  studyId         String
  position        Int
  category        EstimationRequirementCategory
  statement       String
  sourceReference String?
  createdAt       DateTime                      @default(now())

  study EstimationStudy @relation(fields: [studyId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  @@unique([studyId, position])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, studyId, position])
  @@map("estimation_study_requirements")
}

model DqeDocument {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  opportunityId  String?
  code           String
  title          String
  currency       String    @default("USD") @db.Char(3)
  status         DqeStatus @default(DRAFT)
  revision       Int       @default(1)
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines  DqeLine[]
  source DqeStudySource?

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, status, createdAt])
  @@index([opportunityId])
  @@map("dqe_documents")
}

model DqeLine {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  dqeId          String
  position       Int
  reference      String?
  designation    String
  unitCode       String
  quantity       Decimal  @db.Decimal(24, 6)
  unitPrice      Decimal  @db.Decimal(24, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  document DqeDocument @relation(fields: [dqeId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Cascade)

  @@unique([dqeId, position])
  @@index([organizationId, companyId, dqeId, position])
  @@map("dqe_lines")
}

/// Preuve immuable de provenance Study -> DQE. Aucun endpoint UPDATE/DELETE.
model DqeStudySource {
  id                 String   @id @default(cuid())
  organizationId     String
  companyId          String
  dqeId              String   @unique
  studyId            String
  studyCode          String
  studyOpportunityId String
  createdAt          DateTime @default(now())

  dqe   DqeDocument     @relation(fields: [dqeId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  study EstimationStudy @relation(fields: [studyId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  @@unique([dqeId, organizationId, companyId])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, studyId])
  @@map("dqe_study_sources")
}

// ---------------------------------------------------------------------------
// INC-04 — Devis (Quote) -> Contrat (tranche verticale commerciale)
// Reference : docs/foundation/06-product-backlog.md #INC-04.
//
// INVARIANTS :
// 1. Un devis ne peut etre cree que depuis un DQE FINALIZED ; ses lignes sont
//    une copie immuable des lignes du DQE au moment de la creation.
// 2. Un contrat ne peut etre cree que depuis un devis ACCEPTED ; ses lignes
//    sont une copie immuable exacte des lignes du devis accepte.
// 3. Aucune inference juridique (signature, attribution, regime fiscal,
//    juridiction) n'est codee : le contrat reste un enregistrement neutre
//    (pattern ADR-0035 ERP3602 — "legally neutral contract records").
// 4. Un devis ne peut avoir qu'un seul contrat (contrainte unique quoteId).
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  ACTIVE
  ARCHIVED
}

model Quote {
  id              String      @id @default(cuid())
  organizationId  String
  companyId       String
  opportunityId   String
  dqeId           String
  code            String
  title           String
  currency        String      @default("USD") @db.Char(3)
  version         Int         @default(1)
  status          QuoteStatus @default(DRAFT)
  subtotal        Decimal     @db.Decimal(24, 6)
  submittedAt     DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines    QuoteLine[]
  contract Contract?

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@index([organizationId, companyId, status, createdAt])
  @@index([opportunityId])
  @@index([dqeId])
  @@map("sales_quotes")
}

/// Copie immuable des lignes du DQE source au moment de la creation du devis.
model QuoteLine {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  quoteId        String
  position       Int
  reference      String?
  designation    String
  unitCode       String
  quantity       Decimal  @db.Decimal(24, 6)
  unitPrice      Decimal  @db.Decimal(24, 6)
  createdAt      DateTime @default(now())

  quote Quote @relation(fields: [quoteId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Cascade)

  @@unique([quoteId, position])
  @@index([organizationId, companyId, quoteId, position])
  @@map("sales_quote_lines")
}

/// Enregistrement contractuel neutre : aucune portee juridique codee.
model Contract {
  id             String         @id @default(cuid())
  organizationId String
  companyId      String
  opportunityId  String
  quoteId        String         @unique
  code           String
  title          String
  currency       String         @default("USD") @db.Char(3)
  subtotal       Decimal        @db.Decimal(24, 6)
  status         ContractStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines ContractLine[]
  quote Quote          @relation(fields: [quoteId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  @@unique([companyId, code])
  @@unique([id, organizationId, companyId])
  @@unique([quoteId, organizationId, companyId])
  @@index([organizationId, companyId, status, createdAt])
  @@index([opportunityId])
  @@map("sales_contracts")
}

/// Copie immuable exacte des lignes du devis accepte.
model ContractLine {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  contractId     String
  position       Int
  reference      String?
  designation    String
  unitCode       String
  quantity       Decimal  @db.Decimal(24, 6)
  unitPrice      Decimal  @db.Decimal(24, 6)
  createdAt      DateTime @default(now())

  contract Contract @relation(fields: [contractId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Cascade)

  @@unique([contractId, position])
  @@index([organizationId, companyId, contractId, position])
  @@map("sales_contract_lines")
}
