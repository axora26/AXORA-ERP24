// AXORA-ERP24 — Schema Prisma, Phase INC-01 (Core / Identity / RBAC / Audit)
// Reference : docs/foundation/02-domain-model.md, docs/foundation/03-security.md
//
// INVARIANTS NON NEGOCIABLES (ne jamais contourner en code applicatif) :
// 1. Toute table metier porte organizationId — isolation tenant obligatoire.
// 2. AuditLog est append-only : aucune route API ne doit exposer UPDATE/DELETE dessus.
// 3. Les montants financiers utilisent Decimal, jamais Float (regle appliquee des Phase C).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Socle multi-tenant (docs/foundation/02-domain-model.md)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  legalName      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
  users        CompanyMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identite et acces (INC-01)
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  fullName       String
  isActive       Boolean   @default(true)
  mfaEnabled     Boolean   @default(false)
  mfaSecretEnc   String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyMemberships CompanyMembership[]
  sessions        Session[]
  roleAssignments RoleAssignment[]
  auditLogs       AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// RBAC deny-by-default (docs/foundation/03-security.md)
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  assignments     RoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  companyId String?
  projectId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId, projectId])
  @@index([userId])
  @@map("role_assignments")
}

// ---------------------------------------------------------------------------
// Audit append-only (docs/foundation/01-architecture.md §5.1)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
