// AXORA-ERP24 — Schema Prisma, Phase INC-01 (Core / Identity / RBAC / Audit)
// Reference : docs/foundation/02-domain-model.md, docs/foundation/03-security.md
//
// INVARIANTS NON NEGOCIABLES (ne jamais contourner en code applicatif) :
// 1. Toute table metier porte organizationId — isolation tenant obligatoire.
// 2. AuditLog est append-only : aucune route API ne doit exposer UPDATE/DELETE dessus.
// 3. Les montants financiers utilisent Decimal, jamais Float (regle appliquee des Phase C).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Socle multi-tenant (docs/foundation/02-domain-model.md)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  legalName      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
  users        CompanyMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identite et acces (INC-01)
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  fullName       String
  isActive       Boolean   @default(true)
  mfaEnabled     Boolean   @default(false)
  mfaSecretEnc   String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyMemberships CompanyMembership[]
  sessions           Session[]
  roleAssignments    RoleAssignment[]
  auditLogs          AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginThrottle {
  keyHash         String    @id @db.Char(64)
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @default(now()) @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([blockedUntil])
  @@map("login_throttles")
}

// ---------------------------------------------------------------------------
// RBAC deny-by-default (docs/foundation/03-security.md)
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  assignments  RoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  companyId String?
  projectId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId, projectId])
  @@index([userId])
  @@map("role_assignments")
}

// ---------------------------------------------------------------------------
// Audit append-only (docs/foundation/01-architecture.md §5.1)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// INC-02 — CRM (prospects -> opportunites -> pipeline)
// Reference : docs/foundation/06-product-backlog.md #INC-02
//
// INVARIANTS DE CE DOMAINE :
// 1. Toute entite porte organizationId ET companyId (scope entreprise exige
//    par le backlog INC-02). Le companyId n'est jamais accepte tel quel depuis
//    le client : il est verifie contre les CompanyMembership de la session.
// 2. CrmActivity est append-only (historique client immuable) : pas de champ
//    updatedAt, aucune route d'update/delete exposee.
// 3. Les montants utilisent Decimal(18,2) — jamais Float sur un prix.
// ---------------------------------------------------------------------------

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum CrmOpportunityStatus {
  OPEN
  WON
  LOST
}

enum CrmActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  TASK
  STAGE_CHANGE
  CONVERSION
}

model CrmAccount {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  industry       String?
  city           String?
  country        String?
  website        String?
  phone          String?
  email          String?
  ownerUserId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contacts      CrmContact[]
  leads         CrmLead[]
  opportunities CrmOpportunity[]

  @@unique([companyId, name])
  @@index([organizationId, companyId])
  @@map("crm_accounts")
}

model CrmContact {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  accountId      String?
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account       CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunities CrmOpportunity[]

  @@index([organizationId, companyId])
  @@index([accountId])
  @@map("crm_contacts")
}

model CrmLead {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String
  accountId      String?
  contactName    String
  companyName    String
  email          String?
  phone          String?
  source         String?
  status         CrmLeadStatus @default(NEW)
  ownerUserId    String?
  convertedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  account       CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunities CrmOpportunity[]

  @@index([organizationId, companyId])
  @@index([companyId, status])
  @@map("crm_leads")
}

model CrmPipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  position       Int
  probability    Int      @default(0)
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  opportunities CrmOpportunity[]

  @@unique([companyId, name])
  @@index([organizationId, companyId])
  @@map("crm_pipeline_stages")
}

model CrmOpportunity {
  id                String               @id @default(cuid())
  organizationId    String
  companyId         String
  accountId         String?
  contactId         String?
  sourceLeadId      String?
  stageId           String
  name              String
  amount            Decimal              @default(0) @db.Decimal(18, 2)
  currency          String               @default("USD") @db.Char(3)
  expectedCloseDate DateTime?
  status            CrmOpportunityStatus @default(OPEN)
  ownerUserId       String?
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  account    CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact    CrmContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceLead CrmLead?         @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  stage      CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@index([organizationId, companyId])
  @@index([companyId, status])
  @@index([stageId])
  @@map("crm_opportunities")
}

/// Historique client IMMUABLE (backlog INC-02 : "historique client immuable
/// des activites"). Aucun updatedAt, aucune route UPDATE/DELETE exposee.
model CrmActivity {
  id             String          @id @default(cuid())
  organizationId String
  companyId      String
  type           CrmActivityType
  subject        String
  body           String?
  relatedType    String
  relatedId      String
  actorUserId    String?
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([organizationId, companyId])
  @@index([companyId, relatedType, relatedId])
  @@map("crm_activities")
}
