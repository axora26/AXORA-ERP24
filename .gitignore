.env
.env.*
!.env.example
*.pem
*.key

# Runtime data
*.log
*.pid
*.sqlite
*.sqlite-journal
*.db
uploads/
# Stockage objet local des fichiers (GED, preuves chantier) : jamais versionne
.data/

# Prisma generated client (regenere via pnpm db:generate)
packages/database/prisma/migrations/**/migration.sql.bak

# Artefacts Windows : "nul"/"NUL" est un nom de peripherique reserve. Un
# ">NUL" execute dans un shell POSIX cree un vrai fichier que git ne peut
# meme pas indexer ("short read while indexing nul") et qui casse git add.
nul
NUL

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Hermes transient orchestration
.hermes/

# Graphify: keep the reusable graph/report, not local AST caches or dated backups
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Sessions de test navigateur (Playwright) : jamais versionnees
apps/web/e2e/.auth/
