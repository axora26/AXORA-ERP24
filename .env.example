# Copier vers .env et remplir les valeurs reelles. Ne jamais committer .env.
DATABASE_URL="postgresql://axora:axora_dev_password@localhost:5432/axora_erp24_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Session
SESSION_COOKIE_NAME="axora_erp24_session"

# MFA (chiffrement des secrets TOTP) — generer une cle 32 bytes base64 reelle avant usage.
MFA_ENCRYPTION_KEY=""

# Integrations (secrets de signature des webhooks sortants, chiffres au repos) — cle 32 bytes base64.
INTEGRATION_ENCRYPTION_KEY=""
# Moteur de workflow : traitement automatique en tache de fond (false = uniquement via POST /workflow/run).
AUTOMATION_AUTORUN="true"
# Cibles webhook locales/privees (http://127.0.0.1...) : UNIQUEMENT en developpement. Jamais en production (SSRF).
WEBHOOK_ALLOW_PRIVATE_TARGETS="false"

# API
API_PORT=4000
WEB_PORT=3100
CORS_ORIGIN="http://localhost:3100"

# Stockage des fichiers (GED, photos de chantier). Vide = <racine du depot>/.data/files.
# Pilote livre : systeme de fichiers local ; le pilote S3 n'est pas encore livre.
FILE_STORAGE_DIR=""
